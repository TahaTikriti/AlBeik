# Postgres (docker compose maps it to host port 5433)
DATABASE_URL=postgres://albeik:albeik@localhost:5433/albeik

# openssl rand -hex 32
PAYLOAD_SECRET=
# openssl rand -hex 24 (guards the draft-preview route)
PREVIEW_SECRET=

# Public origin of the site (metadata, sitemap, live preview)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Admin user created by `pnpm seed` if it doesn't exist yet
SEED_ADMIN_EMAIL=admin@albeik.local
SEED_ADMIN_PASSWORD=

# Umami Cloud website ID; analytics is a no-op when unset
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional: override the tracker script URL (self-hosted Umami)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
