# ── Required ────────────────────────────────────────────────────────────
# Postgres connection string. A free Neon (neon.tech) or Supabase database
# works. On Vercel, connecting Neon sets this (pooled) and
# DATABASE_URL_UNPOOLED (direct, for migrations). Example:
# postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/albeik?sslmode=require
DATABASE_URL=

# Any long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# Photo storage on Vercel: Storage → Create → Blob, connected to this
# project, sets this for you. Leave empty locally (photos go to media/).
BLOB_READ_WRITE_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────
# Lets `pnpm seed` create your admin login (otherwise create it at /admin).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Needed for the admin's live preview: openssl rand -hex 24
PREVIEW_SECRET=

# The site's public address (defaults to http://localhost:3000).
NEXT_PUBLIC_SERVER_URL=

# Umami Cloud website ID; click tracking is off when empty.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional public Clover Online Ordering URL for testing pickup in demo mode.
# When DATABASE_URL is set, use Site settings → Ordering instead.
CLOVER_PICKUP_URL=

# Local basket spike at /order/pickup-spike. With no keys it shows a dry-run quote.
# Optional keys are only for a Clover sandbox test merchant.
PICKUP_SPIKE_ENABLED=
PICKUP_SPIKE_CLOVER_SANDBOX_MERCHANT_ID=
PICKUP_SPIKE_CLOVER_SANDBOX_PRIVATE_KEY=

# Embedded pickup at /order/pickup-card-spike. Set to preview or sandbox to enable.
PICKUP_CARD_SPIKE_MODE=
# Only use credentials and inventory IDs from the same Clover test merchant.
CLOVER_SANDBOX_MERCHANT_ID=
CLOVER_SANDBOX_IFRAME_PUBLIC_KEY=
CLOVER_SANDBOX_ECOMMERCE_PRIVATE_KEY=
CLOVER_SANDBOX_REST_TOKEN=
CLOVER_SANDBOX_PICKUP_ORDER_TYPE_ID=
# Example single option: [{"slug":"chicken-tawouk-sandwich","itemId":"ITEM_ID","extras":[{"groupId":"GROUP_ID","modifierId":"MODIFIER_ID"}]}]
CLOVER_SANDBOX_PICKUP_MAPPING=
