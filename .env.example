# ── Required ────────────────────────────────────────────────────────────
# Postgres connection string. A free Neon (neon.tech) or Supabase database
# works; use the direct (non-pooled) URL. Example:
# postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/albeik?sslmode=require
DATABASE_URL=

# Any long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Lets `pnpm seed` create your admin login (otherwise create it at /admin).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Needed for the admin's live preview: openssl rand -hex 24
PREVIEW_SECRET=

# The site's public address (defaults to http://localhost:3000).
NEXT_PUBLIC_SERVER_URL=

# Umami Cloud website ID; click tracking is off when empty.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
